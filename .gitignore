__pycache__/
*.pyc
.venv/
venv/
# generated datasets
*.csv
# ...but the ground-truth contract CSV is tracked, not a generated dataset
!lab/ground-truth/*.csv
!lab/ground-truth-meadowmart/*.csv
!lab/ground-truth-picktrail-django/*.csv
# CC-LAB-0136/CC-LAB-0137: category 3's TrackerNest and Huddle Hub apps
# each have their own ground-truth directory (D9's out-of-band contract),
# same "tracked, not generated" rule
!lab/ground-truth-trackernest/*.csv
!lab/ground-truth-huddlehub/*.csv
# CC-LAB-0174: category 4's Netflix and Twitch apps each have their own
# ground-truth directory (D9's out-of-band contract), same "tracked, not
# generated" rule
!lab/ground-truth-netflix-clone/*.csv
!lab/ground-truth-twitch-clone/*.csv
# CC-LAB-0090: category 5's Booking.com app has its own ground-truth
# directory (D9's out-of-band contract), same "tracked, not generated" rule
!lab/ground-truth-booking-clone/*.csv
# CC-LAB-0215/BUG-0036: category 5's Expedia app has its own ground-truth
# directory too; without this exception expectedresults.csv is silently
# gitignored (caught *.csv above) and can never actually be committed
!lab/ground-truth-expedia-clone/*.csv
# CC-LAB-0216: category 2's CircleFeed app has its own ground-truth
# directory too, same BUG-0036 trap -- added proactively this time, not
# found by a later missing-file bug
!lab/ground-truth-circlefeed/*.csv
# python build / test artifacts
*.egg-info/
build/
dist/
.pytest_cache/
# local run store (the shared SQLite project store)
/fuzzlab.db
*.db-wal
*.db-shm
# grey-box DB snapshots (lab-only, regenerated on demand — T3.5)
lab/.snapshots/
# background-agent scratch git worktrees (isolated checkouts for in-progress
# parallel work; never a deliverable, never committed)
.claude/worktrees/
.claude/lane-worktrees/
# local build cache: the github/advisory-database mirror the T-LAB0.8
# pattern-corpus sourcing script (fuzzlab/tools/pattern_corpus_sourcing.py)
# clones/pulls into -- multi-gigabyte upstream data, never the deliverable
# (the deliverable is the small, hand-curated lab/patterns/cards/*.yaml).
.cache/

# runtime audit log fuzzlab/tools/corpus_validation_sandbox.py appends to
# on every real gVisor sandbox run (CC-LAB-0084/FR-LAB-102) -- regenerated
# noise from running the test suite locally, not a tracked deliverable.
docs/research/corpus-validation-audit.jsonl
