{
  "version": 1,
  "rules": [
    {
      "id": "R-SQLI-PARAM",
      "category": "sql-injection",
      "transaction_type": "SQL Injection",
      "when": { "location_in": ["query", "body"] },
      "reference": "sql-injection"
    },
    {
      "id": "R-XSS-REFLECT",
      "category": "xss",
      "transaction_type": "Reflected Input",
      "when": { "location_in": ["query", "body", "fragment"] },
      "reference": "xss"
    },
    {
      "id": "R-OPEN-REDIRECT",
      "category": "open-redirect",
      "transaction_type": "Open Redirect",
      "when": { "name_regex": "url|next|redirect|return|dest|goto|continue|target" },
      "reference": "open-redirect"
    },
    {
      "id": "R-FILE-INCLUSION",
      "category": "file-inclusion",
      "transaction_type": "File Inclusion / Traversal",
      "when": { "name_regex": "file|path|page|include|template|doc|folder|dir|load" },
      "reference": "file-inclusion"
    },
    {
      "id": "R-COMMAND-INJECTION",
      "category": "command-injection",
      "transaction_type": "Command Injection",
      "when": { "name_regex": "cmd|exec|command|ping|host|dns|domain|ip" },
      "reference": "command-injection"
    },
    {
      "id": "R-SSTI",
      "category": "server-side-template-injection",
      "transaction_type": "Template Injection",
      "when": { "location_in": ["query", "body"] },
      "reference": "server-side-template-injection"
    },
    {
      "id": "R-SSRF",
      "category": "ssrf",
      "transaction_type": "Server-Side Request Forgery",
      "when": { "name_regex": "url|uri|link|src|source|target|endpoint|fetch|proxy|webhook|image|thumbnail|avatar" },
      "reference": "ssrf"
    },
    {
      "id": "R-ACCESS-CONTROL",
      "category": "access-control",
      "transaction_type": "Broken Object-Level Authorization",
      "when": { "method_in": ["GET"], "location_in": ["query"], "name_regex": "channel_id|resource_id|object_id|item_id|record_id|owner_id" },
      "reference": "access-control"
    },
    {
      "id": "R-INSECURE-DESERIALIZATION",
      "category": "insecure-deserialization",
      "transaction_type": "Insecure Deserialization",
      "when": { "location_in": ["body"], "sink_context_in": ["deserialization"] },
      "reference": "insecure-deserialization"
    },
    {
      "id": "R-XXE",
      "category": "xxe",
      "transaction_type": "XML External Entity Injection",
      "when": { "location_in": ["body"], "sink_context_in": ["xml"] },
      "reference": "xxe"
    }
  ]
}
