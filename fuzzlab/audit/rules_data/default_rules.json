{
  "version": 1,
  "rules": [
    {
      "id": "R-SQLI-PARAM",
      "category": "sql-injection",
      "transaction_type": "SQL Injection",
      "when": {
        "location_in": [
          "query",
          "body",
          "json",
          "path"
        ],
        "content_type_in": [
          "none"
        ]
      },
      "reference": "sql-injection"
    },
    {
      "id": "R-SQLI-JSON-BODY",
      "category": "sql-injection",
      "transaction_type": "SQL Injection",
      "when": {
        "location_in": [
          "body"
        ],
        "content_type_in": [
          "json"
        ],
        "origin_in": [
          "ground-truth"
        ]
      },
      "reference": "sql-injection",
      "basis": "FR-AUD-701: an answer key's own whole-JSON-body point (rendering server-json, FR-FUZZ-19) keeps the SQL strategies' JSON-aware families; a crawled whole body is the app's own object, which a scalar SQL fragment replaces, so it draws only the whole-body rules"
    },
    {
      "id": "R-NOSQLI-JSON",
      "category": "nosql-injection",
      "transaction_type": "NoSQL Injection",
      "when": {
        "location_in": [
          "json"
        ]
      },
      "reference": "nosql-injection"
    },
    {
      "id": "R-XSS-REFLECT",
      "category": "xss",
      "transaction_type": "Reflected Input",
      "when": {
        "location_in": [
          "query",
          "body",
          "fragment"
        ],
        "content_type_in": [
          "none"
        ]
      },
      "reference": "xss"
    },
    {
      "id": "R-OPEN-REDIRECT",
      "category": "open-redirect",
      "transaction_type": "Open Redirect",
      "when": {
        "location_not_in": [
          "fragment"
        ],
        "name_token_regex": "\\w*ur[il]|next|redir\\w*|return\\w*|dest\\w*|goto|continue|target"
      },
      "reference": "open-redirect"
    },
    {
      "id": "R-FILE-INCLUSION",
      "category": "file-inclusion",
      "transaction_type": "File Inclusion / Traversal",
      "when": {
        "location_not_in": [
          "fragment"
        ],
        "name_token_regex": "\\w*(file|path|folder|dir|page)|(file|path|folder|dir|doc|templat|includ)\\w*|load"
      },
      "reference": "file-inclusion"
    },
    {
      "id": "R-COMMAND-INJECTION",
      "category": "command-injection",
      "transaction_type": "Command Injection",
      "when": {
        "location_not_in": [
          "fragment"
        ],
        "name_token_regex": "cmd\\w*|exec\\w*|command\\w*|ping|\\w*host(name)?|dns\\w*|\\w*domain|ip|ip(v[46]|addr(ess)?)"
      },
      "reference": "command-injection"
    },
    {
      "id": "R-SSTI",
      "category": "server-side-template-injection",
      "transaction_type": "Template Injection",
      "when": {
        "location_in": [
          "query",
          "body",
          "json"
        ],
        "content_type_in": [
          "none",
          "json"
        ]
      },
      "reference": "server-side-template-injection"
    },
    {
      "id": "R-SPEL-INJECTION",
      "category": "spel-injection",
      "transaction_type": "Expression Language Injection",
      "when": {
        "location_in": [
          "query",
          "body",
          "json"
        ],
        "location_not_in": [
          "fragment"
        ],
        "content_type_in": [
          "none"
        ]
      },
      "reference": "spel-injection"
    },
    {
      "id": "R-SSRF",
      "category": "ssrf",
      "transaction_type": "Server-Side Request Forgery",
      "when": {
        "location_not_in": [
          "fragment"
        ],
        "name_token_regex": "\\w*ur[il]|\\w*link|src|\\w*source|target|\\w*endpoint|fetch|proxy|\\w*webhook|\\w*image|avatars?"
      },
      "reference": "ssrf"
    },
    {
      "id": "R-ACCESS-CONTROL",
      "category": "access-control",
      "transaction_type": "Broken Object-Level Authorization",
      "when": {
        "method_in": [
          "GET"
        ],
        "location_in": [
          "query"
        ],
        "name_regex": "(id|uuid|guid)|.*[_-](id|uuid|guid)|.*(?-i:[a-z](Id|ID|Uuid|UUID))"
      },
      "reference": "access-control"
    },
    {
      "id": "R-ACCESS-CONTROL-PATH",
      "category": "access-control",
      "transaction_type": "Broken Object-Level Authorization",
      "when": {
        "method_in": [
          "GET"
        ],
        "location_in": [
          "path"
        ],
        "name_regex": "(id|uuid|guid)|.*[_-](id|uuid|guid)|.*(?-i:[a-z](Id|ID|Uuid|UUID))"
      },
      "reference": "access-control"
    },
    {
      "id": "R-INSECURE-DESERIALIZATION",
      "category": "insecure-deserialization",
      "transaction_type": "Insecure Deserialization",
      "when": {
        "location_in": [
          "body"
        ],
        "sink_context_in": [
          "deserialization"
        ]
      },
      "reference": "insecure-deserialization"
    },
    {
      "id": "R-XXE",
      "category": "xxe",
      "transaction_type": "XML External Entity Injection",
      "when": {
        "location_in": [
          "body"
        ],
        "sink_context_in": [
          "xml"
        ]
      },
      "reference": "xxe"
    },
    {
      "id": "R-JWT-ALG-NONE",
      "category": "jwt-algorithm-confusion",
      "transaction_type": "JWT Algorithm Confusion",
      "when": {
        "location_in": [
          "header"
        ],
        "name_regex": "authorization"
      },
      "reference": "jwt-algorithm-confusion"
    },
    {
      "id": "R-WEAK-TOKEN-ENTROPY",
      "category": "weak-token-entropy",
      "transaction_type": "Predictable Session Token",
      "when": {
        "location_not_in": [
          "fragment"
        ],
        "method_in": [
          "POST"
        ],
        "sink_context_in": [
          "session_token"
        ]
      },
      "reference": "weak-token-entropy"
    },
    {
      "id": "R-MASS-ASSIGNMENT",
      "category": "mass-assignment",
      "transaction_type": "Mass Assignment",
      "when": {
        "location_in": [
          "body"
        ],
        "sink_context_in": [
          "mass_assignment"
        ]
      },
      "reference": "mass-assignment"
    },
    {
      "id": "R-UNRESTRICTED-FILE-UPLOAD",
      "category": "unrestricted-file-upload",
      "transaction_type": "Unrestricted File Upload",
      "when": {
        "location_in": [
          "body"
        ],
        "sink_context_in": [
          "fs_web_root_write"
        ]
      },
      "reference": "upload-insecure-files"
    },
    {
      "id": "R-PRICE-INTEGRITY",
      "category": "price-integrity-bypass",
      "transaction_type": "Price Integrity Bypass",
      "when": {
        "location_not_in": [
          "fragment"
        ],
        "method_in": [
          "POST"
        ],
        "name_token_regex": "\\w*(amount|price|total|cost|charge)"
      },
      "reference": "price-integrity-bypass"
    },
    {
      "id": "R-CSV-FORMULA-INJECTION",
      "category": "csv-formula-injection",
      "transaction_type": "CSV Formula Injection",
      "when": {
        "location_not_in": [
          "fragment"
        ],
        "method_in": [
          "GET"
        ],
        "name_token_regex": "\\w*name|comments?|notes?|description|\\w*title"
      },
      "reference": "csv-formula-injection"
    },
    {
      "id": "R-PRICE-TRUST-DIFFERENTIAL",
      "category": "price-integrity-bypass",
      "transaction_type": "Price/Amount Integrity Bypass",
      "when": {
        "location_in": [
          "body"
        ],
        "sink_context_in": [
          "payment_charge"
        ]
      },
      "reference": "business-logic-price-manipulation"
    },
    {
      "id": "R-HEADER-INJECTION",
      "category": "http-header-injection",
      "transaction_type": "HTTP Response Header Injection",
      "when": {
        "location_in": [
          "query",
          "body"
        ],
        "sink_context_in": [
          "header"
        ]
      },
      "reference": "http-response-splitting"
    },
    {
      "id": "R-PATH-TRAVERSAL",
      "category": "path-traversal",
      "transaction_type": "Path Traversal / Unconfined File Read",
      "when": {
        "location_in": [
          "query",
          "body"
        ],
        "sink_context_in": [
          "fs_path_read"
        ]
      },
      "reference": "directory-traversal"
    },
    {
      "id": "R-LDAP-INJECTION",
      "category": "ldap-injection",
      "transaction_type": "LDAP Injection",
      "when": {
        "location_in": [
          "query",
          "body",
          "json"
        ],
        "content_type_in": [
          "none"
        ]
      },
      "reference": "ldap-injection"
    },
    {
      "id": "R-XPATH-INJECTION",
      "category": "xpath-injection",
      "transaction_type": "XPath Injection",
      "when": {
        "location_in": [
          "query",
          "body",
          "json"
        ],
        "content_type_in": [
          "none"
        ]
      },
      "reference": "xpath-injection"
    },
    {
      "id": "R-SQLI-HEADER",
      "category": "sql-injection",
      "transaction_type": "SQL Injection",
      "when": {
        "location_in": [
          "header"
        ],
        "origin_in": [
          "crawl"
        ]
      },
      "reference": "sql-injection"
    },
    {
      "id": "R-XSS-HEADER",
      "category": "xss",
      "transaction_type": "Reflected Input",
      "when": {
        "location_in": [
          "header"
        ],
        "origin_in": [
          "crawl"
        ]
      },
      "reference": "xss"
    },
    {
      "id": "R-COMMAND-INJECTION-VALUE",
      "category": "command-injection",
      "transaction_type": "Command Injection",
      "when": {
        "location_not_in": [
          "fragment"
        ],
        "value_shape_in": [
          "ip",
          "hostname"
        ]
      },
      "reference": "command-injection"
    },
    {
      "id": "R-OPEN-REDIRECT-VALUE",
      "category": "open-redirect",
      "transaction_type": "Open Redirect",
      "when": {
        "value_shape_in": [
          "url"
        ],
        "location_not_in": [
          "fragment"
        ]
      },
      "reference": "open-redirect"
    },
    {
      "id": "R-SSRF-VALUE",
      "category": "ssrf",
      "transaction_type": "Server-Side Request Forgery",
      "when": {
        "location_not_in": [
          "fragment"
        ],
        "value_shape_in": [
          "url"
        ]
      },
      "reference": "ssrf"
    },
    {
      "id": "R-FILE-INCLUSION-VALUE",
      "category": "file-inclusion",
      "transaction_type": "File Inclusion / Traversal",
      "when": {
        "location_not_in": [
          "fragment"
        ],
        "value_shape_in": [
          "filename",
          "path"
        ]
      },
      "reference": "file-inclusion"
    },
    {
      "id": "R-SSJS",
      "category": "server-side-javascript-injection",
      "transaction_type": "Server-Side JavaScript Injection",
      "when": {
        "location_in": [
          "query",
          "body",
          "json",
          "path"
        ],
        "content_type_in": [
          "none"
        ],
        "server_language_in": [
          "javascript"
        ]
      },
      "reference": "server-side-javascript-injection"
    },
    {
      "id": "R-PATH-TRAVERSAL-NAME",
      "category": "path-traversal",
      "transaction_type": "Path Traversal / Unconfined File Read",
      "when": {
        "location_in": [
          "query",
          "body",
          "json"
        ],
        "content_type_in": [
          "none"
        ],
        "name_token_regex": "\\w*(file|path|folder|dir|page)|(file|path|folder|dir|doc|templat|includ)\\w*|load"
      },
      "reference": "path-traversal",
      "basis": "FR-AUD-700: a parameter named for a file, path, directory, document, page or template (OWASP WSTG v4.2 WSTG-ATHZ-01 input-vector examples file=/page=/item=; PayloadsAllTheThings 'Directory Traversal' and 'File Inclusion'; the public top-25 LFI parameter list: file, path, dir, folder, page, doc, document, include, template)"
    },
    {
      "id": "R-PATH-TRAVERSAL-VALUE",
      "category": "path-traversal",
      "transaction_type": "Path Traversal / Unconfined File Read",
      "when": {
        "location_not_in": [
          "fragment"
        ],
        "content_type_in": [
          "none"
        ],
        "value_shape_in": [
          "filename",
          "path"
        ]
      },
      "reference": "path-traversal",
      "basis": "FR-AUD-700: a value that is a file name or a path (OWASP WSTG-ATHZ-01: 'look for parameters whose value is a file name, e.g. item=ikki.html'; PortSwigger Web Security Academy, 'Path traversal': filename=218.png)"
    },
    {
      "id": "R-HEADER-INJECTION-VALUE",
      "category": "http-header-injection",
      "transaction_type": "HTTP Response Header Injection",
      "when": {
        "location_in": [
          "query",
          "body"
        ],
        "content_type_in": [
          "none"
        ],
        "value_shape_in": [
          "url"
        ]
      },
      "reference": "http-header-injection",
      "basis": "FR-AUD-703: a URL-valued parameter is the one an app copies into Location (OWASP WSTG v4.2 WSTG-INPV-15 HTTP Splitting: the redirect parameter written to the Location header; PortSwigger 'HTTP response header injection' / CRLF via a redirect URL)"
    },
    {
      "id": "R-HEADER-INJECTION-NAME",
      "category": "http-header-injection",
      "transaction_type": "HTTP Response Header Injection",
      "when": {
        "location_in": [
          "query",
          "body"
        ],
        "content_type_in": [
          "none"
        ],
        "name_token_regex": "\\w*ur[il]|next|redir\\w*|return\\w*|dest\\w*|goto|continue|target"
      },
      "reference": "http-header-injection",
      "basis": "FR-AUD-703: a redirect parameter (the R-OPEN-REDIRECT vocabulary) reaches the Location header (OWASP WSTG-INPV-15; OWASP Unvalidated Redirects and Forwards Cheat Sheet; PortSwigger CRLF injection)"
    },
    {
      "id": "R-XXE-XML-BODY",
      "category": "xxe",
      "transaction_type": "XML External Entity Injection",
      "when": {
        "location_in": [
          "body"
        ],
        "content_type_in": [
          "xml"
        ]
      },
      "reference": "xxe",
      "basis": "FR-AUD-701: the request the app itself sent has an XML body (RFC 7303 media types; OWASP WSTG-INPV-07 'Testing for XML Injection'; OWASP XML External Entity Prevention Cheat Sheet; PortSwigger 'XXE injection': any XML request body is an entry point)"
    },
    {
      "id": "R-INSECURE-DESERIALIZATION-JSON",
      "category": "insecure-deserialization",
      "transaction_type": "Insecure Deserialization",
      "when": {
        "location_in": [
          "body"
        ],
        "method_in": [
          "POST",
          "PUT",
          "PATCH"
        ],
        "content_type_in": [
          "json"
        ]
      },
      "reference": "insecure-deserialization",
      "basis": "FR-AUD-701: a JSON request body is what a polymorphic-typing JSON binder reads (OWASP Deserialization Cheat Sheet, Java section on Jackson polymorphic type handling; FasterXML jackson-databind wiki 'Jackson Polymorphic Deserialization CVE Criteria'; PortSwigger 'Insecure deserialization')"
    },
    {
      "id": "R-MASS-ASSIGNMENT-JSON",
      "category": "mass-assignment",
      "transaction_type": "Mass Assignment",
      "when": {
        "location_in": [
          "body"
        ],
        "method_in": [
          "POST",
          "PUT",
          "PATCH"
        ],
        "content_type_in": [
          "json"
        ]
      },
      "reference": "mass-assignment",
      "basis": "FR-AUD-701: a JSON object body bound to a model (OWASP API Security Top 10 2023 API3 Broken Object Property Level Authorization; OWASP Mass Assignment Cheat Sheet; PortSwigger Web Security Academy 'API testing: mass assignment')"
    },
    {
      "id": "R-PRICE-TRUST-JSON",
      "category": "price-integrity-bypass",
      "transaction_type": "Price/Amount Integrity Bypass",
      "when": {
        "location_in": [
          "body"
        ],
        "method_in": [
          "POST",
          "PUT",
          "PATCH"
        ],
        "content_type_in": [
          "json"
        ],
        "body_leaf_token_regex": "\\w*(amount|price|total|cost|charge)"
      },
      "reference": "price-integrity-bypass",
      "basis": "FR-AUD-705: a JSON body whose own leaves carry a price/amount/total/cost/charge (OWASP WSTG v4.2 WSTG-BUSL-01 data validation, the price example; PortSwigger Business logic 'Excessive trust in client-side controls': the price in the request)"
    },
    {
      "id": "R-WEAK-TOKEN-ENTROPY-JSON",
      "category": "weak-token-entropy",
      "transaction_type": "Predictable Session Token",
      "when": {
        "location_in": [
          "body"
        ],
        "method_in": [
          "POST"
        ],
        "content_type_in": [
          "json"
        ],
        "path_token_regex": "tokens?|sessions?|refresh|oauth\\d*|auth|jwt"
      },
      "reference": "weak-token-entropy",
      "basis": "FR-AUD-704: a JSON POST to a token or session endpoint (RFC 6749 \u00a73.2 the token endpoint and \u00a75.1 its JSON response; OpenID Connect Core 1.0 \u00a73.1.3 Token Endpoint; OWASP Session Management Cheat Sheet, Session ID Entropy; OWASP WSTG-SESS-01)"
    },
    {
      "id": "R-UNRESTRICTED-FILE-UPLOAD-MULTIPART",
      "category": "unrestricted-file-upload",
      "transaction_type": "Unrestricted File Upload",
      "when": {
        "location_in": [
          "body"
        ],
        "method_in": [
          "POST",
          "PUT"
        ],
        "content_type_in": [
          "multipart"
        ]
      },
      "reference": "unrestricted-file-upload",
      "basis": "FR-AUD-701: a multipart/form-data body is how a browser uploads a file (HTML Living Standard \u00a74.10.21.7, RFC 7578; OWASP File Upload Cheat Sheet; OWASP WSTG-BUSL-09)"
    }
  ]
}
