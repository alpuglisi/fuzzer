{
  "version": 1,
  "rules": [
    {
      "id": "R-SQLI-PARAM",
      "category": "sql-injection",
      "transaction_type": "SQL Injection",
      "when": { "location_in": ["query", "body"] },
      "reference": "sql-injection"
    },
    {
      "id": "R-XSS-REFLECT",
      "category": "xss",
      "transaction_type": "Reflected Input",
      "when": { "location_in": ["query", "body", "fragment"] },
      "reference": "xss"
    },
    {
      "id": "R-OPEN-REDIRECT",
      "category": "open-redirect",
      "transaction_type": "Open Redirect",
      "when": { "name_regex": "url|next|redirect|return|dest|goto|continue|target" },
      "reference": "open-redirect"
    },
    {
      "id": "R-FILE-INCLUSION",
      "category": "file-inclusion",
      "transaction_type": "File Inclusion / Traversal",
      "when": { "name_regex": "file|path|page|include|template|doc|folder|dir|load" },
      "reference": "file-inclusion"
    },
    {
      "id": "R-COMMAND-INJECTION",
      "category": "command-injection",
      "transaction_type": "Command Injection",
      "when": { "name_regex": "cmd|exec|command|ping|host|dns|domain|ip" },
      "reference": "command-injection"
    },
    {
      "id": "R-SSTI",
      "category": "server-side-template-injection",
      "transaction_type": "Template Injection",
      "when": { "location_in": ["query", "body"] },
      "reference": "server-side-template-injection"
    },
    {
      "id": "R-SPEL-INJECTION",
      "category": "spel-injection",
      "transaction_type": "Expression Language Injection",
      "when": { "name_regex": "sort|sortby|filter|order|expr|expression" },
      "reference": "spel-injection"
    },
    {
      "id": "R-PRICE-INTEGRITY",
      "category": "price-integrity-bypass",
      "transaction_type": "Price Integrity Bypass",
      "when": { "name_regex": "amount|price|total|cost|charge", "method_in": ["POST"] },
      "reference": "price-integrity-bypass"
    }
  ]
}
