{# The method tail is the page's own behavior after its statement runs.
   Default: return the rows as JSON (every illustrative page -- unchanged).
   `session_login` / `register_insert` are the two REAL-page tails lane
   L-P3.3c-G3 needs (login.php establishes a session and redirects;
   register.php inserts the new account after its duplicate check). They are
   flags on this existing complexity rather than new composition modules on
   purpose -- see `php_laravel._SESSION_LOGIN_KEY`. Both twins of a minimal
   pair render the identical tail, so the pair still differs only in its
   transform region.

   `html_row_view` (CC-LAB-0239, docs/LAB_BROWSABLE_APPS_STEP3_PLAN.md step
   3): a fourth tail, for a page whose sink produces a `$rows` associative
   array that should render as a real HTML page instead of the default JSON
   body -- `return view('<name>', $rows)` hands every `$rows` key to the
   named Blade view as its own variable. The view itself is hand-authored
   (not generated), shared byte-for-byte by both twins of the cell pair
   (only the data differs), so it cannot itself leak which twin served the
   request (leakage/fingerprint-independence, R5).

   `html_list_view` (CC-LAB-0240, docs/LAB_PFF_JSON_TO_HTML_PLAN.md §2): a
   fifth tail, for a sink whose `$rows` is a numeric LIST (`DB::select(...)`,
   `->get()->all()`) -- `html_row_view`'s `extract()` would yield zero
   variables from a list, so the list is wrapped under one `rows` key and the
   named, hand-authored, twin-shared Blade view iterates it itself.

   `session_login`'s failure path and `register_insert`'s duplicate/success
   paths render their page's own Blade form view (`form_view`) with the
   message as a view variable (CC-LAB-0240 §3) -- status codes (401/409/200)
   unchanged; the message strings stay literals in the controller source.

   At most one of these flags is ever set: `php_laravel.LaravelEmitter.render`
   fails loud otherwise (`_TAIL_FLAG_KEYS`). #}
    public function {{ method_name }}(Request $request)
    {
{{ body }}
{% if session_login is defined %}
        if ($rows) {
            // A real login page establishes a session for the matched user.
            $request->session()->put('user_id', (int) $rows[0]->{{ session_login.id_column }});
            $request->session()->put('username', $rows[0]->{{ session_login.name_column }});
            return redirect('{{ session_login.redirect_to }}');
        }
        return response()->view('{{ session_login.form_view }}', ['error' => '{{ session_login.error_message }}'], 401);
{% elif html_row_view is defined %}
        return view('{{ html_row_view }}', $rows);
{% elif html_list_view is defined %}
        return view('{{ html_list_view }}', ['rows' => $rows]);
{% elif register_insert is defined %}
        if ($rows) {
            // Re-render the real register form with the error inline and the
            // submitted fields prefilled (Blade escapes every echo).
            return response()->view('{{ register_insert.form_view }}', [
                'error' => '{{ register_insert.taken_message }}',
                'username' => {{ value_expr }},
                'email' => $request->input('{{ register_insert.email_param }}'),
                'full_name' => $request->input('{{ register_insert.full_name_param }}'),
            ], 409);
        }
        // The insert is prepared too: every value is bound by the query
        // builder, never spliced into the statement text.
        DB::table('{{ table }}')->insert([
{% for column in register_insert.columns %}
{% if column == 'password' %}
            '{{ column }}' => {{ register_insert.password_hash_fn }}($request->input('{{ register_insert.password_param }}')),
{% elif column == 'bio' %}
            '{{ column }}' => '',
{% elif column == register_insert.email_param %}
            '{{ column }}' => $request->input('{{ register_insert.email_param }}'),
{% elif column == register_insert.full_name_param %}
            '{{ column }}' => $request->input('{{ register_insert.full_name_param }}'),
{% else %}
            '{{ column }}' => {{ value_expr }},
{% endif %}
{% endfor %}
        ]);
        return response()->view('{{ register_insert.form_view }}', ['registered_username' => {{ value_expr }}], 200);
{% else %}
        return response()->json($rows);
{% endif %}
    }
