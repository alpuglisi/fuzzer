from __future__ import annotations

from collections.abc import Generator

from sqlalchemy import create_engine, text
from sqlalchemy.orm import Session, sessionmaker

DATABASE_URL = "sqlite:///./{{ app_slug }}.db"

engine = create_engine(DATABASE_URL, connect_args={"check_same_thread": False})
SessionLocal = sessionmaker(autocommit=False, autoflush=False, bind=engine)


def _seed() -> None:
    with engine.begin() as conn:
        conn.execute(
            text(
                "CREATE TABLE IF NOT EXISTS products ("
                "id INTEGER PRIMARY KEY, name TEXT, price REAL, description TEXT)"
            )
        )
        conn.execute(
            text(
                "CREATE TABLE IF NOT EXISTS users ("
                "id INTEGER PRIMARY KEY, username TEXT UNIQUE, password TEXT, bio TEXT)"
            )
        )
        conn.execute(text("DELETE FROM products"))
        conn.execute(text("DELETE FROM users"))
        conn.execute(
            text("INSERT INTO products (id, name, price, description) VALUES (1, 'Puppy Bed', 39.99, 'Cozy bed')")
        )
        conn.execute(
            text(
                "INSERT INTO users (id, username, password, bio) VALUES "
                "(1, 'ryder', :password, 'Loves puppies and fort-building.')"
            ),
            {"password": __import__("hashlib").sha256(b"changeme").hexdigest()},
        )


_seed()


def get_db() -> Generator[Session, None, None]:
    db = SessionLocal()
    try:
        yield db
    finally:
        db.close()


def get_current_user() -> dict:
    """Stub identity for the render_only/html-body sample cell -- no real
    session/auth layer is built for this Tier-A sample (matches
    php_current's own `$currentUser['bio']` page-profile stub; Phase 2's
    identity/session work, once landed, is the real replacement)."""
    with SessionLocal() as db:
        row = db.execute(text("SELECT bio FROM users WHERE id = 1")).mappings().first()
        return {"bio": row["bio"] if row else ""}
