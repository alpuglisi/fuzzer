"""Generated by fuzzlab.labgen.emitters.python_fastapi -- one-time stack scaffold.

Site layer for the generic FastAPI sample (CC-LAB-0246 / FR-LAB-169,
Browsable Labs Lane 6): one shared layout, a homepage linking every page the
build serves, and a GET form page for every POST endpoint (design contract
point 4; no CSRF token -- the sample has none, and a form page must neither
add nor remove protection).

The page table below is rendered statically from the emitter's own
`_PAGE_PARAMS` (never read back from `app.routes`, whose shape varies across
FastAPI versions). `SERVED` is filled by `main.py`'s router discovery with
the (method, path) pairs actually served -- twins included, at their
`/twin/<cell-id>` prefix -- so the homepage lists exactly what this build
serves. `layout()` output is byte-identical wherever it is used, so it can
never tell a vulnerable twin from a secure one.
"""

from __future__ import annotations

import html

from fastapi import APIRouter, FastAPI
from fastapi.responses import HTMLResponse

APP_NAME = "{{ app_name }}"

#: path -> {"label": ..., "form_fields": (...)} (from `_PAGE_PARAMS`).
PAGES: dict[str, dict] = {{ pages_literal }}

#: (method, served path) pairs, appended by `main.py` during discovery.
SERVED: list[tuple[str, str]] = []

#: Header nav: "/" plus every canonical (non-twin) page, sorted by path.
NAV: list[tuple[str, str]] = []

_STYLE = (
    "body{margin:0;font-family:system-ui,sans-serif;background:#f7f7fb;color:#1c1c28}"
    "header{background:#3b3f8f;color:#fff;padding:12px 20px}"
    "header a{color:#fff;margin-right:14px;text-decoration:none}"
    "header .brand{font-weight:700;margin-right:24px}"
    "main{max-width:760px;margin:24px auto;padding:0 16px}"
    "footer{color:#666;font-size:.85em;text-align:center;padding:24px}"
    "table{border-collapse:collapse}td,th{border:1px solid #ccd;padding:4px 8px;text-align:left}"
)


def _base_path(path: str) -> str:
    """`/twin/<cell-id>/products` -> `/products`; other paths unchanged."""
    if path.startswith("/twin/"):
        return "/" + path.split("/", 3)[3]
    return path


def _label(path: str) -> str:
    base = _base_path(path)
    label = PAGES.get(base, {}).get("label", base)
    if base != path:
        return f"{label} (twin {path.split('/')[2]})"
    return label


def layout(title: str, body_html: str) -> str:
    nav = "".join(f'<a href="{href}">{html.escape(text)}</a>' for href, text in NAV)
    return (
        "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n"
        f"<title>{html.escape(title)} - {APP_NAME}</title>\n<style>{_STYLE}</style>\n</head>\n<body>\n"
        f'<header><span class="brand">{APP_NAME}</span>{nav}</header>\n'
        f"<main>\n{body_html}\n</main>\n"
        f"<footer>{APP_NAME} - illustrative lab sample, loopback only</footer>\n"
        "</body>\n</html>\n"
    )


def render_row(title: str, row: dict | None) -> str:
    """A SQL lookup's result as an HTML detail view: a found row is a table
    of its columns; no row is a short not-found paragraph (the found/not-found
    difference a boolean differential needs is kept, plan R-B2)."""
    if row is None:
        return layout(title, f"<h1>{html.escape(title)}</h1>\n<p>No matching record.</p>")
    cells = "\n".join(
        f"<tr><th>{html.escape(str(key))}</th><td>{html.escape(str(value))}</td></tr>"
        for key, value in row.items()
    )
    return layout(
        title,
        f"<h1>{html.escape(title)}</h1>\n<p>Record details, as stored.</p>\n"
        f"<table>\n{cells}\n</table>\n<p>Found 1 matching record.</p>",
    )


def _home() -> str:
    served_get = {path for method, path in SERVED if method == "GET"}
    items = []
    for path in sorted({path for _, path in SERVED}):
        if path in served_get or path in _form_paths():
            items.append(f'<li><a href="{path}">{html.escape(_label(path))}</a></li>')
    return layout(
        "Home",
        f"<h1>{APP_NAME}</h1>\n<p>An illustrative FastAPI sample application. "
        "Every page this build serves is listed below.</p>\n<ul>\n" + "\n".join(items) + "\n</ul>",
    )


def _form_paths() -> list[str]:
    """Served POST paths that have no GET route of their own and a declared form."""
    served_get = {path for method, path in SERVED if method == "GET"}
    return sorted(
        path for method, path in set(SERVED)
        if method == "POST" and path not in served_get and PAGES.get(_base_path(path), {}).get("form_fields")
    )


def _form_page(path: str) -> str:
    fields = PAGES[_base_path(path)]["form_fields"]
    inputs = "\n".join(
        f'<p><label>{html.escape(name)} <input name="{name}"'
        + (' type="password"' if name == "password" else "")
        + "></label></p>"
        for name in fields
    )
    title = _label(path)
    return layout(
        title,
        f"<h1>{html.escape(title)}</h1>\n<form method=\"post\" action=\"{path}\">\n{inputs}\n"
        '<p><button type="submit">Submit</button></p>\n</form>',
    )


def install(app: FastAPI) -> None:
    """Called once by `main.py`, after router discovery filled `SERVED`."""
    NAV[:] = [("/", "Home")] + [
        (path, PAGES[path]["label"])
        for path in sorted({p for _, p in SERVED if not p.startswith("/twin/") and p in PAGES})
    ]
    router = APIRouter()

    def home() -> HTMLResponse:
        return HTMLResponse(content=_home())

    router.add_api_route("/", home, methods=["GET"])
    for path in _form_paths():
        router.add_api_route(path, _form_endpoint(path), methods=["GET"])
    app.include_router(router)


def _form_endpoint(path: str):
    """A no-argument endpoint bound to one path by closure (a default
    argument would become a request query parameter under FastAPI)."""
    def form() -> HTMLResponse:
        return HTMLResponse(content=_form_page(path))

    return form
