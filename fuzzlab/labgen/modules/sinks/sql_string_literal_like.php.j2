{% if bound %}
// A bound LIKE pattern: the wildcards are added to the *parameter*, never to
// the statement text, so the closing quote is not reachable from the value.
$stmt = $pdo->prepare("SELECT id, {{ column }} FROM {{ table }} WHERE {{ column }} LIKE ?");
$stmt->execute(['%' . {{ value_expr }} . '%']);
$row = $stmt->fetch(PDO::FETCH_ASSOC);
{% else %}
// The LIKE wildcards are part of the statement text and the value is spliced
// between them, so the value sits in a quoted string literal it can close.
$sql = "SELECT id, {{ column }} FROM {{ table }} WHERE {{ column }} LIKE '%" . {{ value_expr }} . "%'";
$result = $pdo->query($sql);
$row = $result ? $result->fetch(PDO::FETCH_ASSOC) : null;
{% endif %}
