{
  "version": 1,
  "target": "puppy-fort-factory",
  "cases": [
    {
      "case_id": "PFF-0001",
      "url": "/product.php",
      "method": "GET",
      "param": "id",
      "location": "query",
      "vuln_class": "sqli",
      "subtypes": ["error", "boolean", "union", "time"],
      "sink_context": "sql",
      "expected_vulnerable": true,
      "rendering": "server",
      "notes": "id concatenated raw into WHERE; verbose DB errors surfaced"
    },
    {
      "case_id": "PFF-0002",
      "url": "/search.php",
      "method": "GET",
      "param": "q",
      "location": "query",
      "vuln_class": "sqli",
      "subtypes": ["union", "time"],
      "sink_context": "sql",
      "expected_vulnerable": true,
      "rendering": "server",
      "notes": "q in a raw LIKE clause"
    },
    {
      "case_id": "PFF-0003",
      "url": "/search.php",
      "method": "GET",
      "param": "q",
      "location": "query",
      "vuln_class": "xss-reflected",
      "sink_context": "html",
      "expected_vulnerable": true,
      "rendering": "server",
      "notes": "q echoed unescaped into the HTML body"
    },
    {
      "case_id": "PFF-0004",
      "url": "/login.php",
      "method": "POST",
      "param": "username",
      "location": "body",
      "vuln_class": "sqli",
      "subtypes": ["auth-bypass", "time"],
      "sink_context": "sql",
      "expected_vulnerable": true,
      "rendering": "server",
      "notes": "username concatenated raw; classic auth bypass"
    },
    {
      "case_id": "PFF-0005",
      "url": "/profile.php",
      "method": "GET",
      "param": "bio",
      "location": "body",
      "vuln_class": "xss-stored",
      "sink_context": "html",
      "expected_vulnerable": true,
      "rendering": "server",
      "source_url": "/edit_profile.php",
      "notes": "bio stored via prepared stmt (not SQLi) then rendered unescaped on profile.php"
    },
    {
      "case_id": "PFF-0006",
      "url": "/blog_post.php",
      "method": "GET",
      "param": "id",
      "location": "query",
      "vuln_class": "sqli",
      "subtypes": ["blind-boolean", "time"],
      "sink_context": "sql",
      "expected_vulnerable": true,
      "rendering": "server",
      "notes": "id concatenated raw; DB errors suppressed -> blind only"
    },
    {
      "case_id": "PFF-0007",
      "url": "/reviews.php",
      "method": "GET",
      "param": "author",
      "location": "fragment",
      "vuln_class": "xss-dom",
      "sink_context": "dom",
      "expected_vulnerable": true,
      "rendering": "js",
      "notes": "location.hash author written via innerHTML; never reaches the server"
    },
    {
      "case_id": "PFF-0008",
      "url": "/feedback.php",
      "method": "GET",
      "param": "ref",
      "location": "query",
      "vuln_class": "xss-dom",
      "sink_context": "dom",
      "expected_vulnerable": true,
      "rendering": "js",
      "notes": "ref query param used client-side only, written via innerHTML"
    },

    {
      "case_id": "PFF-1001",
      "url": "/products.php",
      "method": "GET",
      "param": "category",
      "location": "query",
      "vuln_class": "none",
      "sink_context": "none",
      "expected_vulnerable": false,
      "rendering": "server",
      "notes": "prepared statement + escaped output"
    },
    {
      "case_id": "PFF-1002",
      "url": "/track.php",
      "method": "GET",
      "param": "order_id",
      "location": "query",
      "vuln_class": "none",
      "sink_context": "none",
      "expected_vulnerable": false,
      "rendering": "server",
      "notes": "integer cast; canned status"
    },
    {
      "case_id": "PFF-1003",
      "url": "/api/products.php",
      "method": "GET",
      "param": "category",
      "location": "query",
      "vuln_class": "none",
      "sink_context": "none",
      "expected_vulnerable": false,
      "rendering": "server-json",
      "notes": "prepared statement; JSON output"
    },
    {
      "case_id": "PFF-1004",
      "url": "/register.php",
      "method": "POST",
      "param": "username",
      "location": "body",
      "vuln_class": "none",
      "sink_context": "none",
      "expected_vulnerable": false,
      "rendering": "server",
      "notes": "prepared statements + escaped output"
    },
    {
      "case_id": "PFF-1005",
      "url": "/contact.php",
      "method": "POST",
      "param": "message",
      "location": "body",
      "vuln_class": "none",
      "sink_context": "none",
      "expected_vulnerable": false,
      "rendering": "server",
      "notes": "reflected through htmlspecialchars"
    },
    {
      "case_id": "PFF-1006",
      "url": "/newsletter.php",
      "method": "POST",
      "param": "email",
      "location": "body",
      "vuln_class": "none",
      "sink_context": "none",
      "expected_vulnerable": false,
      "rendering": "server",
      "notes": "escaped echo; no DB write"
    },
    {
      "case_id": "PFF-1007",
      "url": "/edit_profile.php",
      "method": "POST",
      "param": "full_name",
      "location": "body",
      "vuln_class": "none",
      "sink_context": "none",
      "expected_vulnerable": false,
      "rendering": "server",
      "notes": "prepared update; escaped where rendered"
    },
    {
      "case_id": "PFF-1008",
      "url": "/login.php",
      "method": "POST",
      "param": "password",
      "location": "body",
      "vuln_class": "none",
      "sink_context": "none",
      "expected_vulnerable": false,
      "rendering": "server",
      "notes": "md5-hashed before use; not an injection point"
    }
  ]
}
