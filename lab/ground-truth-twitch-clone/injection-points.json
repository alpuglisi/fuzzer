{
  "version": 1,
  "target": "go_net_http",
  "points": [
    {
      "url": "/webhooks/eventsub",
      "method": "POST",
      "param": "X-Signature-256",
      "location": "header",
      "rendering": "server-json"
    },
    {
      "url": "/api/clips/thumbnail",
      "method": "GET",
      "param": "url",
      "location": "query",
      "rendering": "server-json"
    },
    {
      "url": "/channels/analytics",
      "method": "GET",
      "param": "channel_id",
      "location": "query",
      "rendering": "server-json"
    },
    {
      "url": "/channels/settings",
      "method": "GET",
      "param": "Authorization",
      "location": "header",
      "rendering": "server-json"
    },
    {
      "url": "/sessions/refresh",
      "method": "POST",
      "param": "body",
      "location": "body",
      "rendering": "server-json"
    },
    {
      "url": "/channels/profile",
      "method": "POST",
      "param": "body",
      "location": "body",
      "rendering": "server-json"
    },
    {
      "url": "/channels/subscribers",
      "method": "GET",
      "param": "channel_id",
      "location": "query",
      "rendering": "server-json"
    },
    {
      "url": "/clips/download",
      "method": "GET",
      "param": "source_url",
      "location": "query",
      "rendering": "server-json"
    },
    {
      "url": "/channels/emotes/upload",
      "method": "POST",
      "param": "file",
      "location": "body",
      "rendering": "server"
    },
    {
      "url": "/subscriptions/purchase",
      "method": "POST",
      "param": "body",
      "location": "body",
      "rendering": "server-json"
    },
    {
      "url": "/clips/export",
      "method": "GET",
      "param": "filename",
      "location": "query",
      "rendering": "server-json"
    },
    {
      "url": "/channels/commands",
      "method": "POST",
      "param": "body",
      "location": "body",
      "rendering": "server-json"
    },
    {
      "url": "/channels/redirect",
      "method": "GET",
      "param": "destination",
      "location": "query",
      "rendering": "server-json"
    },
    {
      "url": "/auth/login-redirect",
      "method": "GET",
      "param": "next",
      "location": "query",
      "rendering": "server-json"
    }
  ]
}