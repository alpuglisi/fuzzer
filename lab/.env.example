# Copy to lab/.env and adjust for your machine. These are LOCAL LAB credentials
# for a deliberately vulnerable app — do not reuse real passwords, and never
# expose this stack. Real secrets belong in the OS keyring, not in the repo.
PFF_DB_NAME=puppy_fort
PFF_DB_USER=pff
PFF_DB_PASS=pff_lab_pw
PFF_DB_ROOT_PASS=root_lab_pw
# Host port for the web tier (bound to 127.0.0.1 only).
PFF_WEB_PORT=8080
# Lab WAF (D16): a deliberately naive, configurable request prefilter — the target
# the Phase 8 mutation engine learns to bypass. DEFAULT OFF: leave it off for normal
# runs (existing ground truth assumes no filter); turn it on only for filter-evasion
# experiments. Mode: block (403), sanitize (strip the match), or log (observe only).
PFF_WAF=off
PFF_WAF_MODE=block
